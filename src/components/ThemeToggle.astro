<button id="theme-toggle" type="button" aria-label="Toggle theme">
  <svg class="icon-light" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
    <circle cx="12" cy="12" r="4.2" />
    <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" />
  </svg>
  <svg class="icon-dark" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
  </svg>
</button>
<style>
  #theme-toggle {
    background: none; border: 1px solid var(--hairline); border-radius: 8px;
    color: var(--ink); cursor: pointer; width: 38px; height: 38px; flex: none;
    display: inline-grid; place-items: center; padding: 0;
  }
  #theme-toggle:hover { border-color: var(--accent); }
  .icon-dark { display: none; }
  :global([data-theme='dark']) .icon-light { display: none; }
  :global([data-theme='dark']) .icon-dark { display: block; }
</style>
{/* The toggle click is handled by a delegated listener in BaseLayout so it keeps
    working across View-Transition navigations. */}
