---
// One quiet row at the bottom of every inner page: links to all four pages on the
// left (the way onward, now that pages no longer end with big section links), and
// where else to find Simon on the right. No copyright line.
import { SECTIONS, sectionForPath } from '../lib/sections';

const current = sectionForPath(Astro.url.pathname);
const pages = [
  { href: '/', label: 'Home', current: false },
  ...SECTIONS.map((s) => ({ href: s.href, label: s.label, current: s.id === current })),
];
const socials = [
  { href: 'https://www.linkedin.com/in/simonkuester/', label: 'LinkedIn' },
  { href: 'mailto:simonkuester@gmail.com', label: 'Email' },
  { href: '/resume.pdf', label: 'Resume' },
  { href: '/rss.xml', label: 'RSS' },
];
---
<footer class="site-footer">
  <nav aria-label="Footer">
    <ul>
      {pages.map((p) => <li><a href={p.href} aria-current={p.current ? 'page' : undefined}>{p.label}</a></li>)}
    </ul>
  </nav>
  <ul class="social">
    {socials.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
  </ul>
</footer>
<style>
  .site-footer {
    display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--space-2) var(--space-4);
    max-width: var(--maxw-page); margin: var(--space-6) auto 0; padding: var(--space-3);
    border-top: 1px solid var(--hairline);
  }
  .site-footer ul { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-3); list-style: none; margin: 0; padding: 0; }
  .site-footer a { color: var(--muted); font-size: 0.9rem; }
  .site-footer a:hover { color: var(--accent); }
  .site-footer a[aria-current='page'] { color: var(--ink); }
  /* small screens: the two groups stack, left aligned */
  @media (max-width: 640px) {
    .site-footer { flex-direction: column; align-items: flex-start; gap: var(--space-2); }
  }
</style>
