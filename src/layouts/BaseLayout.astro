---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { NO_SECTION, SECTIONS, sectionForPath } from '../lib/sections';
// The animated names are set in these faces, so each page preloads the one it opens
// with: the big name on the home cover (600) or the header wordmark (700).
import coverFont from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-600-normal.woff2?url';
import wordmarkFont from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-700-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  /** Home cover: no header or footer; a corner theme toggle instead. */
  cover?: boolean;
  /** Fill exactly one screen: header, content centred in the rest, footer. */
  fill?: boolean;
}

const {
  title,
  description = 'Simon Kuester — cybersecurity professional. Experience, projects, and writing.',
  image = '/og.png',
  type = 'website',
  cover = false,
  fill = false,
} = Astro.props;

const fullTitle = title === 'Simon Kuester' ? title : `${title} — Simon Kuester`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

// Each inner page takes its section's colour for links, buttons and the header dot.
const section = sectionForPath(Astro.url.pathname);
const colors = SECTIONS.find((s) => s.id === section) ?? NO_SECTION;
const sectionVars = cover
  ? ''
  : `body{--g:${colors.gradient};--accent:${colors.accentLight};--accent-contrast:#FFFFFF}` +
    `[data-theme='dark'] body{--accent:${colors.accentDark};--accent-contrast:#0F0E0C}`;
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Simon Kuester — Writing" href="/rss.xml" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <ClientRouter />

    <link rel="preload" as="font" type="font/woff2" href={cover ? coverFont : wordmarkFont} crossorigin />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    {sectionVars && <style is:inline set:html={sectionVars}></style>}

    <!-- Set theme before paint, re-apply after each view transition (no flash), and
         handle the toggle via one delegated listener so it keeps working across swaps.
         Also runs the two load-in animations' bookkeeping (see the comments inside). -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const apply = () => {
          const saved = localStorage.getItem('theme');
          root.setAttribute('data-theme', saved === 'light' ? 'light' : 'dark');
        };
        apply();
        if (!window.__themeBound) {
          window.__themeBound = true;
          document.addEventListener('astro:after-swap', apply);
          document.addEventListener('click', (e) => {
            const t = e.target instanceof Element ? e.target.closest('#theme-toggle') : null;
            if (!t) return;
            const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            root.setAttribute('data-theme', next);
            localStorage.setItem('theme', next);
          });

          // Header intro (html.intro): the name slides from the middle to the left and the
          // tabs slide out to the right. Played when the header first appears: on a fresh
          // load of an inner page, and when arriving from the home cover (which has no
          // header). The class is cleared once the animation has had time to finish, so
          // moving between tabs never replays it.
          let introTimer = 0;
          const armIntroEnd = () => {
            clearTimeout(introTimer);
            introTimer = setTimeout(() => root.classList.remove('intro'), 2000);
          };
          window.__playIntro = () => {
            root.classList.add('intro');
            if (!root.classList.contains('fonts-pending')) armIntroEnd();
          };
          let hadHeader = true;
          document.addEventListener('astro:before-swap', () => { hadHeader = !!document.querySelector('.site-header'); });
          document.addEventListener('astro:after-swap', () => {
            if (!hadHeader && document.querySelector('.site-header')) window.__playIntro();
          });

          // First load only: hold both load-ins (html.fonts-pending pauses them) until the
          // display font is ready, so a name never changes typeface halfway through.
          // Released after 1.2s no matter what, and never set at all without JavaScript.
          root.classList.add('fonts-pending');
          const release = () => {
            if (!root.classList.contains('fonts-pending')) return;
            root.classList.remove('fonts-pending');
            if (root.classList.contains('intro')) armIntroEnd();
          };
          const wait = () => {
            const ready = document.fonts
              ? Promise.all([
                  document.fonts.load('600 1em "Cormorant Garamond"'),
                  document.fonts.load('700 1em "Cormorant Garamond"'),
                ]).then(() => document.fonts.ready)
              : Promise.resolve();
            ready.then(release, release);
          };
          if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', wait);
          else wait();
          setTimeout(release, 1200);
        }
      })();
    </script>
    {!cover && <script is:inline>window.__playIntro && window.__playIntro();</script>}
  </head>
  <body data-section={cover ? undefined : (section ?? 'none')} data-fill={fill ? '' : undefined}>
    <a href="#main" class="visually-hidden">Skip to content</a>
    {cover ? <div class="cover-toggle"><ThemeToggle /></div> : <Header />}
    <main id="main">
      <slot />
    </main>
    {!cover && <Footer />}
  </body>
</html>

<style>
  .cover-toggle { position: fixed; top: 16px; right: 16px; z-index: 20; }
</style>
